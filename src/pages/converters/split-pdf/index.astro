---
import BaseLayout from '../../../layouts/BaseLayout.astro';
const description='Split a PDF in your browser: extract a page range, save every page as its own file, or split into chunks of N pages. Copies pages as-is. Nothing is uploaded.';
const jsonLd=[
{'@context':'https://schema.org','@type':'BreadcrumbList',itemListElement:[{'@type':'ListItem',position:1,name:'Home',item:'https://deskutil.com/'},{'@type':'ListItem',position:2,name:'Converter Tools',item:'https://deskutil.com/converters/'},{'@type':'ListItem',position:3,name:'Split PDF',item:'https://deskutil.com/converters/split-pdf/'}]},
