---
<BaseLayout title="PDF to JPG Online — Convert PDF Pages to JPEG Images" description={description} canonical="https://deskutil.com/converters/pdf-to-jpg/" jsonLd={jsonLd}>
<div class="shell breadcrumbs"><nav aria-label="Breadcrumb"><ol><li><a href="/">Home</a></li><li><a href="/converters/">Converters</a></li><li aria-current="page">PDF to JPG</li></ol></nav></div>
<section class="shell page-heading tool-wrap"><p class="eyebrow">Converter tool</p><h1>PDF to JPG</h1><p>Turn each PDF page into a JPEG image in your browser. This is a raster conversion—scanned pages work because they are images. Nothing is uploaded.</p>
<div class="tool-panel"><div class="tool-topbar" role="toolbar" aria-label="PDF to JPG actions"><button class="tool-button primary" id="convert" type="button">Convert</button><button class="tool-button" id="download-all" type="button" disabled>Download all pages</button><span class="privacy-note">Processed only in your browser</span></div>
<p class="tool-note">Each page is drawn to a canvas and saved as JPG. This does not keep vector text or layers.</p>
<div class="file-drop" id="drop-zone"><div class="file-drop-inner"><label class="tool-check" for="pdf-file">PDF file</label><input class="field-input" id="pdf-file" type="file" accept="application/pdf,.pdf" /><p class="file-meta" id="file-meta">Choose a PDF or drop it here. Conversion stays on this device.</p></div></div>
<div class="tool-fields"><div class="tool-field"><label for="jpg-quality">JPEG quality: <span id="quality-label">92%</span></label><input class="field-range" id="jpg-quality" type="range" min="50" max="100" value="92" /></div></div>
<div class="preview-grid" id="previews" hidden></div>
<p class="status" id="status" role="status" aria-live="polite">Choose a PDF, then convert. Files above about 50 pages may be slow.</p></div>
<div class="content-grid"><article class="prose"><h2>How to use PDF to JPG</h2><p>Choose a PDF, set JPEG quality if you want, then <strong>Convert</strong>. Each page is rendered in your browser. Download pages one by one or use <strong>Download all pages</strong> (your browser may prompt for multiple files). Password-protected PDFs fail with a clear error. Nothing is uploaded.</p>
<h2>Frequently asked questions</h2>
<h3>How does PDF to JPG conversion work?</h3><p>Each page is rasterized to a canvas with pdf.js, then exported as a JPEG. It is an image conversion, not a vector export.</p>
<h3>Do scanned PDFs work?</h3><p>Yes. Scanned pages are already images, so raster conversion is a good fit. You get one JPG per page.</p>
<h3>Can I download every page at once?</h3><p>You can download the current page or trigger sequential downloads for all pages. Your browser may ask to allow multiple downloads.</p>
<h3>Is my PDF uploaded?</h3><p>No. Rendering happens in your browser. Images never leave your device.</p>
<h3>What quality should I use?</h3><p>Higher quality makes larger files. 0.85–0.92 is a practical range for sharing; use 1.0 when you need maximum JPEG quality.</p></article>
<aside class="aside-card"><h2>Explore Deskutil</h2><ul><li><a href="/converters/">Converter tools</a></li><li><a href="/converters/pdf-to-word/">PDF to Word</a></li><li><a href="/converters/base64-encoder/">Base64 Encoder</a></li><li><a href="/">All live tools</a></li><li><a href="/privacy/">How privacy works</a></li><li><a href="/text-tools/word-counter/">Word Counter</a></li></ul></aside></div></section>

<script>
const WARN_PAGES=50;
const MAX_PAGES=200;
const MAX_BYTES=40*1024*1024;
const MAX_EDGE=4096;
const PDFJS_SRC="https://cdnjs.cloudflare.com/ajax/libs/pdf.js/6.2.108/pdf.min.mjs";
const PDFJS_WORKER="https://cdnjs.cloudflare.com/ajax/libs/pdf.js/6.2.108/pdf.worker.min.mjs";
let pdfjsLib:any=null;
type PageOut={name:string;url:string;blob:Blob};
let pages:PageOut[]=[];
const fileInput=document.querySelector<HTMLInputElement>('#pdf-file')!;
const dropZone=document.querySelector<HTMLElement>('#drop-zone')!;
const fileMeta=document.querySelector<HTMLElement>('#file-meta')!;
const quality=document.querySelector<HTMLInputElement>('#jpg-quality')!;
const qualityLabel=document.querySelector<HTMLElement>('#quality-label')!;
const previews=document.querySelector<HTMLElement>('#previews')!;
const convertBtn=document.querySelector<HTMLButtonElement>('#convert')!;
const downloadAllBtn=document.querySelector<HTMLButtonElement>('#download-all')!;
const status=document.querySelector<HTMLParagraphElement>('#status')!;
const setStatus=(message:string,kind='')=>{status.textContent=message;status.className=`status ${kind}`.trim()};
const clearPages=()=>{pages.forEach((page)=>URL.revokeObjectURL(page.url));pages=[];previews.innerHTML='';previews.hidden=true;downloadAllBtn.disabled=true};
quality.addEventListener('input',()=>{qualityLabel.textContent=`${quality.value}%`});
const chosenFile=()=>{const file=fileInput.files?.[0];if(!file)throw new Error('Choose a PDF first.');if(file.size>MAX_BYTES)throw new Error('That PDF is larger than 40 MB. Try a smaller file.');if(!file.type.includes('pdf')&&!file.name.toLowerCase().endsWith('.pdf'))throw new Error('Choose a PDF file.');return file};
fileInput.addEventListener('change',()=>{try{const file=chosenFile();fileMeta.textContent=`${file.name} (${Math.round(file.size/1024)} KB)`;clearPages();setStatus('PDF selected. Choose Convert.')}catch(error){fileMeta.textContent='Choose a PDF or drop it here. Conversion stays on this device.';setStatus(error instanceof Error?error.message:'Could not read that file.','error')}});
['dragenter','dragover'].forEach((eventName)=>dropZone.addEventListener(eventName,(event)=>{event.preventDefault();dropZone.classList.add('drag')}));
['dragleave','drop'].forEach((eventName)=>dropZone.addEventListener(eventName,(event)=>{event.preventDefault();dropZone.classList.remove('drag')}));
dropZone.addEventListener('drop',(event)=>{const file=event.dataTransfer?.files?.[0];if(!file)return;const list=new DataTransfer();list.items.add(file);fileInput.files=list.files;fileInput.dispatchEvent(new Event('change'))});
const loadPdfjs=async()=>{if(pdfjsLib)return pdfjsLib;const mod:any=await import(/* @vite-ignore */ PDFJS_SRC);pdfjsLib=mod.default??mod;pdfjsLib.GlobalWorkerOptions.workerSrc=PDFJS_WORKER;return pdfjsLib};
const stem=(name:string)=>name.replace(/\.pdf$/i,'')||'page';
const renderPdf=async()=>{
  const file=chosenFile();
  setStatus('Loading PDF…');
  const pdfjs=await loadPdfjs();
  const data=await file.arrayBuffer();
  let doc:any;
  try{doc=await pdfjs.getDocument({data}).promise}catch(error:any){throw new Error(error?.name==="PasswordException"||error?.code===1||error?.code===2?"This PDF is password-protected. Remove the password and try again. Nothing was uploaded.":"Could not open that PDF. Damaged files cannot be converted here.")}
  if(!doc.numPages)throw new Error("This PDF has no pages."); if(doc.numPages>MAX_PAGES)throw new Error("This PDF has "+doc.numPages+" pages. Convert a file with "+MAX_PAGES+" pages or fewer."); const count=doc.numPages;
  const warn=count>WARN_PAGES?(" "+count+" pages may take a while and can slow this tab."):"" ;
  clearPages();
  const q=Number(quality.value)/100;
  const base=stem(file.name);
  for(let i=1;i<=count;i++){
    setStatus("Rendering page "+i+" of "+count+"..."+warn);
    const page=await doc.getPage(i);
    const baseViewport=page.getViewport({scale:1});
    const scale=Math.min(2,MAX_EDGE/Math.max(baseViewport.width,baseViewport.height));
    const viewport=page.getViewport({scale});
    const canvas=document.createElement('canvas');
    canvas.width=Math.floor(viewport.width);
    canvas.height=Math.floor(viewport.height);
    const context=canvas.getContext("2d",{alpha:false});
    if(!context)throw new Error("Could not draw this page."); context.fillStyle="#fff"; context.fillRect(0,0,canvas.width,canvas.height);
    await page.render({canvasContext:context,viewport}).promise;
    const blob=await new Promise<Blob>((resolve,reject)=>canvas.toBlob((value)=>value?resolve(value):reject(new Error('Could not make a JPEG.')),'image/jpeg',q));
    const url=URL.createObjectURL(blob);
    const name=`${base}-page-${i}.jpg`;
    pages.push({name,url,blob});
    const card=document.createElement('div');
    card.className='preview-card';
    const img=document.createElement('img');
    img.src=url;img.alt=`Page ${i}`;
    const button=document.createElement('button');
    button.className='tool-button';button.type='button';button.textContent=`Download page ${i}`;
    button.addEventListener('click',()=>{const link=document.createElement('a');link.href=url;link.download=name;link.click()});
    card.append(img,button);previews.append(card); await new Promise((resolve)=>setTimeout(resolve,0));
  }
  previews.hidden=false;
  downloadAllBtn.disabled=!pages.length;
  setStatus(count===1?'Converted 1 page.':'Converted '+count+' pages.','success');
};
convertBtn.addEventListener('click',async()=>{convertBtn.disabled=true;try{await renderPdf()}catch(error){setStatus(error instanceof Error?error.message:'Could not convert that PDF.','error')}finally{convertBtn.disabled=false}});
downloadAllBtn.addEventListener('click',async()=>{if(!pages.length)return;for(const page of pages){const link=document.createElement('a');link.href=page.url;link.download=page.name;link.click();await new Promise((resolve)=>setTimeout(resolve,250))}setStatus('Started downloads. Your browser may ask to allow multiple files.','success')});
</script></BaseLayout>
