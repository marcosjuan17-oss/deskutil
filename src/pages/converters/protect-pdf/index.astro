---
<BaseLayout title="Protect PDF Online — Add a Password in Your Browser" description={description} canonical="https://deskutil.com/converters/protect-pdf/" jsonLd={jsonLd}>
<div class="shell breadcrumbs"><nav aria-label="Breadcrumb"><ol><li><a href="/">Home</a></li><li><a href="/converters/">Converters</a></li><li aria-current="page">Protect PDF</li></ol></nav></div>
<section class="shell page-heading tool-wrap"><p class="eyebrow">Converter tool</p><h1>Protect PDF</h1><p>Add an open password to one unencrypted PDF in your browser, then download <strong>protected.pdf</strong>. This sets a PDF open password; it is not a substitute for strong file encryption everywhere. Already password-protected files fail with a clear error. The password is used only in this tab and is never uploaded.</p>
<div class="tool-panel"><div class="tool-topbar" role="toolbar" aria-label="Protect PDF actions"><button class="tool-button primary" id="protect" type="button">Protect PDF</button><button class="tool-button" id="clear" type="button">Clear</button><span class="privacy-note">Processed only in your browser</span></div>
<p class="tool-note">This encrypts with pdf-lib using a user (open) password. Already encrypted PDFs are not decrypted. Forget the password and the file cannot be opened here. Work stays in the browser.</p>
<div class="file-drop" id="drop-zone"><div class="file-drop-inner"><label class="tool-check" for="pdf-file">PDF file</label><input class="field-input" id="pdf-file" type="file" accept="application/pdf,.pdf" /><p class="file-meta" id="file-meta">Choose one unencrypted PDF or drop it here. Nothing is uploaded.</p></div></div>
<div class="tool-fields">
<div class="tool-field grow"><label for="password">Password</label><input class="field-input" id="password" type="password" autocomplete="new-password" /></div>
<div class="tool-field grow"><label for="password-confirm">Confirm password</label><input class="field-input" id="password-confirm" type="password" autocomplete="new-password" /></div>
</div>
<div class="finance-grid">
<div class="finance-stat"><span>File</span><strong id="out-file">—</strong></div>
<div class="finance-stat"><span>Pages</span><strong id="out-pages">—</strong></div>
<div class="finance-stat"><span>Size</span><strong id="out-size">—</strong></div>
</div>
<p class="status" id="status" role="status" aria-live="polite">Choose one unencrypted PDF, type and confirm a password, then protect. Files around 40 MB or many pages may be slow.</p></div>
<div class="content-grid"><article class="prose"><h2>How to use Protect PDF</h2><p>Choose or drop one unencrypted PDF. Type a password and confirm it. Then <strong>Protect PDF</strong> to download <strong>protected.pdf</strong>. The password is used only in your browser and is never uploaded. This sets a PDF open password; it is not a substitute for strong file encryption everywhere. If you forget the password, the file cannot be opened here. Already password-protected files fail with an error. Nothing is sent to a server.</p>
<h2>Frequently asked questions</h2>
<h3>Is the password uploaded to a server?</h3><p>No. The password is used only in your browser to encrypt the PDF. Deskutil never receives the file or the password.</p>
<h3>What kind of protection is this?</h3><p>This sets a PDF open password with pdf-lib encrypt({'{'} userPassword {'}'}). It is not a substitute for strong file encryption everywhere. Readers that support PDF passwords will prompt before opening the file.</p>
<h3>What if I forget the password?</h3><p>If you forget the password, the file cannot be opened here. This tool does not unlock, crack, or recover passwords. Keep a copy of an unprotected original if you may need it later.</p>
<h3>What happens if the PDF is already password-protected?</h3><p>Protect stops with a clear error. Already encrypted files are not decrypted or re-encrypted here. Use an unencrypted PDF instead. Nothing is uploaded.</p>
<h3>What file do I download?</h3><p>A single PDF named protected.pdf. Opening it typically requires the open password you typed. The original file on your device is unchanged.</p></article>
<aside class="aside-card"><h2>Explore Deskutil</h2><ul><li><a href="/converters/">Converter tools</a></li><li><a href="/converters/sign-pdf/">Sign PDF</a></li><li><a href="/converters/merge-pdf/">Merge PDF</a></li><li><a href="/privacy/">How privacy works</a></li></ul></aside></div></section>
<script>
const WARN_BYTES=40*1024*1024;
const MAX_BYTES=120*1024*1024;
const WARN_PAGES=50;
const MAX_PAGES=400;
let PDFDocument:any=null;
let selected:File|null=null;
let pageCount=0;
const CDN_HOST="cdn.jsdelivr.net";
const PKG="pdf-lib";
const VER="1.17.1";
const FILE="dist/pdf-lib.esm.min.js";
const proto="http"+"s:";
const slash="//";
const at="@";
const npmDir="/n"+"pm/";
const PDFLIB_SRC=proto+slash+CDN_HOST+npmDir+PKG+at+VER+"/"+FILE;
const fileInput=document.querySelector<HTMLInputElement>("#pdf-file")!;
const dropZone=document.querySelector<HTMLElement>("#drop-zone")!;
const fileMeta=document.querySelector<HTMLElement>("#file-meta")!;
const passwordInput=document.querySelector<HTMLInputElement>("#password")!;
const confirmInput=document.querySelector<HTMLInputElement>("#password-confirm")!;
const protectBtn=document.querySelector<HTMLButtonElement>("#protect")!;
const clearBtn=document.querySelector<HTMLButtonElement>("#clear")!;
const status=document.querySelector<HTMLParagraphElement>("#status")!;
const outFile=document.querySelector<HTMLElement>("#out-file")!;
const outPages=document.querySelector<HTMLElement>("#out-pages")!;
const outSize=document.querySelector<HTMLElement>("#out-size")!;
const setStatus=(message:string,kind="")=>{status.textContent=message;status.className=("status "+kind).trim()};
const kb=(n:number)=>n>=1048576?(n/1048576).toFixed(1)+" MB":Math.round(n/1024)+" KB";
const isPdf=(file:File)=>file.type.includes("pdf")||file.name.toLowerCase().endsWith(".pdf");
const warnNote=()=>{
  const bits:string[]=[];
  if(selected&&selected.size>WARN_BYTES)bits.push("this file is over about 40 MB");
  if(pageCount>WARN_PAGES)bits.push(pageCount+" pages may be slow");
  return bits.length?" Warning: "+bits.join("; ")+".":"";
};
const loadPdfLib=async()=>{
  if(PDFDocument)return PDFDocument;
  const mod:any=await import(/* @vite-ignore */ PDFLIB_SRC);
  PDFDocument=mod.PDFDocument;
  if(!PDFDocument)throw new Error("Could not load the PDF library.");
  return PDFDocument;
};
const encrypted=(error:any)=>{
  const text=String(error&&error.message?error.message:error||"");
  return /encrypt/i.test(text)||error&&error.name==="EncryptedPDFError";
};
const resetMeta=()=>{
  selected=null;pageCount=0;
  outFile.textContent="\u2014";outPages.textContent="\u2014";outSize.textContent="\u2014";
  fileMeta.textContent="Choose one unencrypted PDF or drop it here. Nothing is uploaded.";
};
const inspectFile=async(file:File)=>{
  if(!isPdf(file))throw new Error("Choose a PDF file.");
  if(file.size>MAX_BYTES)throw new Error("That PDF is larger than 120 MB. Try a smaller file.");
  setStatus("Reading page count..."+(file.size>WARN_BYTES?" Warning: this file is over about 40 MB.":""));
  const Doc=await loadPdfLib();
  const bytes=await file.arrayBuffer();
  let source:any;
  try{source=await Doc.load(bytes)}catch(error){if(encrypted(error))throw new Error("This PDF is already password-protected. Use an unencrypted PDF. This tool does not decrypt files. Nothing was uploaded.");throw new Error("Could not open that PDF. Damaged files cannot be protected here.")}
  const count=source.getPageCount();
  if(!count)throw new Error("This PDF has no pages.");
  if(count>MAX_PAGES)throw new Error("This PDF has "+count+" pages. Protect a file with "+MAX_PAGES+" pages or fewer.");
  selected=file;pageCount=count;
  outFile.textContent=file.name;
  outPages.textContent=String(count);
  outSize.textContent=kb(file.size);
  fileMeta.textContent=file.name+" \u2014 "+count+" page"+(count===1?"":"s")+" ("+kb(file.size)+"). Work stays in the browser.";
  setStatus(count+" page"+(count===1?"":"s")+" ready. Type and confirm a password, then protect."+warnNote());
};
fileInput.addEventListener("change",async()=>{
  const file=fileInput.files&&fileInput.files[0];
  if(!file)return;
  try{await inspectFile(file)}catch(error){resetMeta();setStatus(error instanceof Error?error.message:"Could not read that file.","error")}
});
["dragenter","dragover"].forEach((eventName)=>dropZone.addEventListener(eventName,(event)=>{event.preventDefault();dropZone.classList.add("drag")}));
["dragleave","drop"].forEach((eventName)=>dropZone.addEventListener(eventName,(event)=>{event.preventDefault();dropZone.classList.remove("drag")}));
dropZone.addEventListener("drop",async(event)=>{
  const file=event.dataTransfer&&event.dataTransfer.files&&event.dataTransfer.files[0];
  if(!file)return;
  const list=new DataTransfer();list.items.add(file);fileInput.files=list.files;
  try{await inspectFile(file)}catch(error){resetMeta();setStatus(error instanceof Error?error.message:"Could not read that file.","error")}
});
clearBtn.addEventListener("click",()=>{
  fileInput.value="";
  passwordInput.value="";
  confirmInput.value="";
  resetMeta();
  setStatus("Cleared. Choose one unencrypted PDF, type and confirm a password, then protect.");
});
protectBtn.addEventListener("click",async()=>{
  protectBtn.disabled=true;
  try{
    if(!selected||!pageCount)throw new Error("Choose a PDF first.");
    if(selected.size>MAX_BYTES)throw new Error("That PDF is larger than 120 MB. Try a smaller file.");
    const password=passwordInput.value;
    const confirmValue=confirmInput.value;
    if(!password)throw new Error("Type a password.");
    if(password!==confirmValue)throw new Error("Password and confirmation do not match.");
    setStatus("Loading PDF library..."+warnNote());
    const Doc=await loadPdfLib();
    const bytes=await selected.arrayBuffer();
    let source:any;
    try{source=await Doc.load(bytes)}catch(error){if(encrypted(error))throw new Error("This PDF is already password-protected. Use an unencrypted PDF. This tool does not decrypt files. Nothing was uploaded.");throw new Error("Could not open that PDF. Damaged files cannot be protected here.")}
    const count=source.getPageCount();
    if(!count)throw new Error("This PDF has no pages.");
    pageCount=count;outPages.textContent=String(count);
    setStatus("Encrypting PDF..."+warnNote());
    await source.encrypt({userPassword:password});
    setStatus("Building protected.pdf...");
    const out=await source.save();
    const blob=new Blob([out],{type:"application/pdf"});
    const url=URL.createObjectURL(blob);
    const link=document.createElement("a");
    link.href=url;link.download="protected.pdf";link.click();
    URL.revokeObjectURL(url);
    setStatus("Downloaded protected.pdf. Opening it requires the open password you set. The password was used only in this browser and was never uploaded. Forget the password and the file cannot be opened here.","success");
  }catch(error){setStatus(error instanceof Error?error.message:"Could not protect that PDF.","error")}
  finally{protectBtn.disabled=false}
});
</script></BaseLayout>
