---
import BaseLayout from '../../../layouts/BaseLayout.astro';
const description='Add page numbers to a PDF in your browser with pdf-lib, then download numbered.pdf. Choose position, format, start number, and font size. Overlay only: numbers may sit on existing content. Password-protected files fail with a clear error. Nothing is uploaded.';
const jsonLd=[
{'@context':'https://schema.org','@type':'BreadcrumbList',itemListElement:[{'@type':'ListItem',position:1,name:'Home',item:'https://deskutil.com/'},{'@type':'ListItem',position:2,name:'Converter Tools',item:'https://deskutil.com/converters/'},{'@type':'ListItem',position:3,name:'Add Page Numbers',item:'https://deskutil.com/converters/add-page-numbers/'}]},
{'@context':'https://schema.org','@type':'SoftwareApplication',name:'Add Page Numbers',applicationCategory:'UtilitiesApplication',operatingSystem:'Any',url:'https://deskutil.com/converters/add-page-numbers/',offers:{'@type':'Offer',price:'0',priceCurrency:'USD'},featureList:['Add page numbers to a PDF in the browser','Bottom or top position','Formats 1, 1 / N, and Page 1','Start number and font size','Reject password-protected PDFs','Download numbered.pdf']},
