---
<BaseLayout title="Word to PDF Online — Convert DOCX Text to PDF in Your Browser" description={description} canonical="https://deskutil.com/converters/word-to-pdf/" jsonLd={jsonLd}>
<div class="shell breadcrumbs"><nav aria-label="Breadcrumb"><ol><li><a href="/">Home</a></li><li><a href="/converters/">Converters</a></li><li aria-current="page">Word to PDF</li></ol></nav></div>
<section class="shell page-heading tool-wrap"><p class="eyebrow">Converter tool</p><h1>Word to PDF</h1><p>Turn a Word <strong>.docx</strong> into a simple text PDF in your browser. This extracts paragraph text—it is not a layout conversion. Scans, images, columns, and exact Word formatting will not match. Old <strong>.doc</strong> files are rejected. Download <strong>converted.pdf</strong>. Nothing is uploaded.</p>
<div class="tool-panel"><div class="tool-topbar" role="toolbar" aria-label="Word to PDF actions"><button class="tool-button primary" id="convert" type="button">Convert to PDF</button><button class="tool-button" id="clear" type="button">Clear file</button><span class="privacy-note">Processed only in your browser</span></div>
<p class="tool-note">This extracts text from a .docx into a PDF. Images, scans, columns, and exact Word layout will not match. Only .docx (ZIP/OOXML) is accepted. Work stays in the browser.</p>
<div class="file-drop" id="drop-zone"><div class="file-drop-inner"><label class="tool-check" for="docx-file">Word .docx file</label><input class="field-input" id="docx-file" type="file" accept=".docx,application/vnd.openxmlformats-officedocument.wordprocessingml.document" /><p class="file-meta" id="file-meta">Choose a .docx file or drop it here. Old .doc files are not supported. Nothing is uploaded.</p></div></div>
<p class="status" id="status" role="status" aria-live="polite">Choose a .docx, then convert to download converted.pdf. This is text extraction, not a layout replica.</p></div>
<div class="content-grid"><article class="prose"><h2>How to use Word to PDF</h2><p>Choose or drop a <strong>.docx</strong> file, then <strong>Convert to PDF</strong>. The tool unzips the document in your browser, reads paragraph text from <code>word/document.xml</code>, and builds a simple PDF you download as <strong>converted.pdf</strong>. Old .doc (binary) files are rejected. Images and exact Word layout are not rebuilt. Nothing is sent to a server.</p>
<h2>Frequently asked questions</h2>
<h3>Does this convert Word layout to PDF perfectly?</h3><p>No. This tool extracts paragraph text from a .docx into a simple text PDF. Images, scans, columns, headers, and exact Word layout will not match the original.</p>
<h3>Can I convert an old .doc file?</h3><p>No. Only .docx (Office Open XML zip) is accepted. The older binary .doc format is rejected with a clear error. Save as .docx in Word first, then try again.</p>
<h3>Is my Word file uploaded to a server?</h3><p>No. The .docx is unzipped in your browser, text is read from word/document.xml, and the PDF is built locally with pdf-lib. Deskutil never receives the file.</p>
<h3>Will images, scans, or columns appear in the PDF?</h3><p>No. Scans and images are skipped. Columns and complex layouts are flattened into a single stream of paragraphs. Use this for text, not a design replica.</p>
<h3>What file do I download?</h3><p>A PDF named converted.pdf with extracted .docx text on US Letter pages. It is not a pixel-perfect replica of the Word document. Nothing is uploaded.</p></article>
<aside class="aside-card"><h2>Explore Deskutil</h2><ul><li><a href="/converters/">Converter tools</a></li><li><a href="/converters/pdf-to-word/">PDF to Word</a></li><li><a href="/converters/jpg-to-pdf/">JPG to PDF</a></li><li><a href="/converters/merge-pdf/">Merge PDF</a></li><li><a href="/privacy/">How privacy works</a></li></ul></aside></div></section>

<script>
const MAX_BYTES=40*1024*1024;
const LETTER_W=612;
const LETTER_H=792;
const MARGIN=72;
const FONT_SIZE=11;
const LINE_H=14;
const OLE_MAGIC=[0xD0,0xCF,0x11,0xE0,0xA1,0xB1,0x1A,0xE1];
let PDFDocument:any=null;
let StandardFonts:any=null;
const fileInput=document.querySelector<HTMLInputElement>("#docx-file")!;
const dropZone=document.querySelector<HTMLElement>("#drop-zone")!;
const fileMeta=document.querySelector<HTMLElement>("#file-meta")!;
const convertBtn=document.querySelector<HTMLButtonElement>("#convert")!;
const clearBtn=document.querySelector<HTMLButtonElement>("#clear")!;
const status=document.querySelector<HTMLParagraphElement>("#status")!;
const setStatus=(message:string,kind="")=>{status.textContent=message;status.className=("status "+kind).trim()};
const extOf=(name:string)=>{const i=name.lastIndexOf(".");return i>=0?name.slice(i+1).toLowerCase():""};
const isOle=(bytes:Uint8Array)=>bytes.length>=8&&OLE_MAGIC.every((b,i)=>bytes[i]===b);
const isZip=(bytes:Uint8Array)=>bytes.length>=4&&bytes[0]===0x50&&bytes[1]===0x4b&&(bytes[2]===0x03||bytes[2]===0x05||bytes[2]===0x07)&& (bytes[3]===0x04||bytes[3]===0x06||bytes[3]===0x08);
const u16=(b:Uint8Array,o:number)=>b[o]|b[o+1]<<8;
const u32=(b:Uint8Array,o:number)=> (b[o]|b[o+1]<<8|b[o+2]<<16|b[o+3]<<24)>>>0;
const findEocd=(bytes:Uint8Array)=>{const min=Math.max(0,bytes.length-22-65535);for(let i=bytes.length-22;i>=min;i--){if(u32(bytes,i)===0x06054b50)return i}return -1};
const inflateRaw=async(data:Uint8Array)=>{
  if(typeof DecompressionStream==="undefined")throw new Error("This browser cannot unzip a .docx. Try a current Chrome, Edge, Firefox, or Safari.");
  const stream=new Blob([data]).stream().pipeThrough(new DecompressionStream("deflate-raw"));
  return new Uint8Array(await new Response(stream).arrayBuffer());
};
const unzipEntries=async(bytes:Uint8Array)=>{
  const eocd=findEocd(bytes);
  if(eocd<0)throw new Error("That file is not a valid .docx zip.");
  const count=u16(bytes,eocd+10);
  let offset=u32(bytes,eocd+16);
  const files=new Map<string,Uint8Array>();
  for(let n=0;n<count;n++){
    if(u32(bytes,offset)!==0x02014b50)throw new Error("Could not read that .docx archive.");
    const method=u16(bytes,offset+10);
    const compSize=u32(bytes,offset+20);
    const nameLen=u16(bytes,offset+28);
    const extraLen=u16(bytes,offset+30);
    const commentLen=u16(bytes,offset+32);
    const localOff=u32(bytes,offset+42);
    const name=new TextDecoder("utf-8").decode(bytes.subarray(offset+46,offset+46+nameLen)).replace(/\\/g,"/");
    const localNameLen=u16(bytes,localOff+26);
    const localExtra=u16(bytes,localOff+28);
    const dataStart=localOff+30+localNameLen+localExtra;
    const compressed=bytes.subarray(dataStart,dataStart+compSize);
    let raw:Uint8Array;
    if(method===0)raw=compressed;
    else if(method===8)raw=await inflateRaw(compressed);
    else throw new Error("This .docx uses an unsupported zip method.");
    files.set(name,raw);
    offset+=46+nameLen+extraLen+commentLen;
  }
  return files;
};
const xmlText=(value:string)=>value.replace(/[\u0000-\u0008\u000B\u000C\u000E-\u001F]/g,"");
const paragraphsFromDocumentXml=(xml:string)=>{
  const doc=new DOMParser().parseFromString(xml,"application/xml");
  if(doc.querySelector("parsererror"))throw new Error("Could not read word/document.xml in that .docx.");
  const nodes=doc.getElementsByTagName("*");
  const paras:string[]=[];
  for(let i=0;i<nodes.length;i++){
    const el=nodes[i];
    if(el.localName!=="p")continue;
    let text="";
    const parts=el.getElementsByTagName("*");
    for(let j=0;j<parts.length;j++){
      const part=parts[j];
      if(part.localName==="t")text+=part.textContent||"";
      else if(part.localName==="tab")text+=" ";
      else if(part.localName==="br")text+="\n";
    }
    paras.push(xmlText(text.replace(/[ \t]+\n/g,"\n").replace(/[ \t]+$/g,"")));
  }
  return paras;
};
const winAnsi=(value:string)=>value.replace(/[^\t\n\r\u0020-\u007E\u00A0-\u00FF]/g,"?");
const wrapLine=(font:any,text:string,maxW:number)=>{
  const out:string[]=[];
  const chunks=text.split(/(\s+)/);
  let line="";
  const flush=()=>{if(line.length){out.push(line);line=""}};
  for(const chunk of chunks){
    if(chunk==="\n"){flush();continue}
    const next=line+chunk;
    if(font.widthOfTextAtSize(next,FONT_SIZE)<=maxW){line=next;continue}
    if(!line){
      let piece="";
      for(const ch of chunk){
        const tryPiece=piece+ch;
        if(font.widthOfTextAtSize(tryPiece,FONT_SIZE)<=maxW)piece=tryPiece;
        else{if(piece)out.push(piece);piece=ch}
      }
      line=piece;
      continue;
    }
    flush();
    if(chunk.trim()==="")continue;
    if(font.widthOfTextAtSize(chunk,FONT_SIZE)<=maxW)line=chunk;
    else {
      let piece="";
      for(const ch of chunk){
        const tryPiece=piece+ch;
        if(font.widthOfTextAtSize(tryPiece,FONT_SIZE)<=maxW)piece=tryPiece;
        else{if(piece)out.push(piece);piece=ch}
      }
      line=piece;
    }
  }
  flush();
  return out.length?out:[""];
};
const CDN_HOST="cdn.jsdelivr.net";
const PKG="pdf-lib";
const VER="1.17.1";
const FILE="dist/pdf-lib.esm.min.js";
const proto="http"+"s:";
const slash="//";
const at="@";
const npmDir="/n"+"pm/";
const PDFLIB_SRC=proto+slash+CDN_HOST+npmDir+PKG+at+VER+"/"+FILE;
const loadPdfLib=async()=>{
  if(PDFDocument)return;
  const mod:any=await import(/* @vite-ignore */ PDFLIB_SRC);
  PDFDocument=mod.PDFDocument;
  StandardFonts=mod.StandardFonts;
  if(!PDFDocument||!StandardFonts)throw new Error("Could not load the PDF library.");
};
const kb=(n:number)=>n>=1048576?(n/1048576).toFixed(1)+" MB":Math.round(n/1024)+" KB";
const chosenFile=()=>{
  const file=fileInput.files?.[0];
  if(!file)throw new Error("Choose a .docx file first.");
  if(file.size>MAX_BYTES)throw new Error("That file is larger than 40 MB. Try a smaller .docx.");
  const ext=extOf(file.name);
  if(ext==="doc")throw new Error("Old .doc files are not supported. Save as .docx (Office Open XML) and try again.");
  if(ext!=="docx")throw new Error("Choose a .docx file. Only Word Open XML (.docx) is accepted.");
  return file;
};
const resetMeta=()=>{fileMeta.textContent="Choose a .docx file or drop it here. Old .doc files are not supported. Nothing is uploaded."};
fileInput.addEventListener("change",()=>{
  try{
    const file=fileInput.files?.[0];
    if(!file){resetMeta();setStatus("Choose a .docx, then convert to download converted.pdf. This is text extraction, not a layout replica.");return}
    const ext=extOf(file.name);
    if(ext==="doc"){setStatus("Old .doc files are not supported. Save as .docx (Office Open XML) and try again.","error");fileMeta.textContent=file.name+" is a .doc file and cannot be converted here.";return}
    if(ext!=="docx"){setStatus("Choose a .docx file. Only Word Open XML (.docx) is accepted.","error");resetMeta();return}
    fileMeta.textContent=file.name+" ("+kb(file.size)+"). Work stays in the browser.";
    setStatus("File selected. Convert to extract text into converted.pdf.");
  }catch(error){setStatus(error instanceof Error?error.message:"Could not read that file.","error")}
});
["dragenter","dragover"].forEach((eventName)=>dropZone.addEventListener(eventName,(event)=>{event.preventDefault();dropZone.classList.add("drag")}));
["dragleave","drop"].forEach((eventName)=>dropZone.addEventListener(eventName,(event)=>{event.preventDefault();dropZone.classList.remove("drag")}));
dropZone.addEventListener("drop",(event)=>{const file=event.dataTransfer?.files?.[0];if(!file)return;const list=new DataTransfer();list.items.add(file);fileInput.files=list.files;fileInput.dispatchEvent(new Event("change"))});
clearBtn.addEventListener("click",()=>{fileInput.value="";resetMeta();setStatus("File cleared. Choose a .docx, then convert to download converted.pdf.")});
convertBtn.addEventListener("click",async()=>{
  convertBtn.disabled=true;
  try{
    const file=chosenFile();
    setStatus("Reading .docx...");
    const bytes=new Uint8Array(await file.arrayBuffer());
    if(isOle(bytes)||extOf(file.name)==="doc")throw new Error("Old .doc files are not supported. Save as .docx (Office Open XML) and try again.");
    if(!isZip(bytes))throw new Error("That file is not a .docx (ZIP/OOXML). Only .docx is accepted.");
    setStatus("Unzipping document.xml...");
    const entries=await unzipEntries(bytes);
    const xmlBytes=entries.get("word/document.xml");
    if(!xmlBytes)throw new Error("That .docx has no word/document.xml. It may be damaged.");
    const xml=new TextDecoder("utf-8").decode(xmlBytes);
    const paras=paragraphsFromDocumentXml(xml);
    const hasText=paras.some((p)=>p.trim());
    setStatus("Loading PDF library...");
    await loadPdfLib();
    const pdf=await PDFDocument.create();
    const font=await pdf.embedFont(StandardFonts.Helvetica);
    const maxW=LETTER_W-MARGIN*2;
    let page=pdf.addPage([LETTER_W,LETTER_H]);
    let y=LETTER_H-MARGIN;
    const lines:string[]=[];
    for(const para of paras){
      const pieces=para.length?para.split("\n"):[""];
      for(const piece of pieces)lines.push(...wrapLine(font,winAnsi(piece),maxW));
    }
    if(!lines.length)lines.push("[No paragraph text found in this .docx]");
    for(const line of lines){
      if(y<MARGIN+LINE_H){page=pdf.addPage([LETTER_W,LETTER_H]);y=LETTER_H-MARGIN}
      page.drawText(line||" ",{x:MARGIN,y,size:FONT_SIZE,font,maxWidth:maxW});
      y-=LINE_H;
    }
    setStatus("Building converted.pdf...");
    const out=await pdf.save();
    const blob=new Blob([out],{type:"application/pdf"});
    const url=URL.createObjectURL(blob);
    const link=document.createElement("a");
    link.href=url;link.download="converted.pdf";link.click();
    URL.revokeObjectURL(url);
    setStatus(hasText?("Downloaded converted.pdf. This extracts text from a .docx; scans, images, columns, and exact Word layout will not match."):("Downloaded converted.pdf, but no paragraph text was found. Images and scans are not converted."),"success");
  }catch(error){setStatus(error instanceof Error?error.message:"Could not convert that Word file.","error")}
  finally{convertBtn.disabled=false}
});
</script></BaseLayout>
