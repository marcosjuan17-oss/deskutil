const description='Convert an Excel .xlsx spreadsheet to a simple text-table PDF in your browser. First worksheet only, cell values only, no charts. Layout will not match Excel. Old .xls files are not supported. Nothing is uploaded.';
const jsonLd=[
{'@context':'https://schema.org','@type':'BreadcrumbList',itemListElement:[{'@type':'ListItem',position:1,name:'Home',item:'https://deskutil.com/'},{'@type':'ListItem',position:2,name:'Converter Tools',item:'https://deskutil.com/converters/'},{'@type':'ListItem',position:3,name:'Excel to PDF',item:'https://deskutil.com/converters/excel-to-pdf/'}]},
