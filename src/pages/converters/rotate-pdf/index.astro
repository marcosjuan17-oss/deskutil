{'@context':'https://schema.org','@type':'SoftwareApplication',name:'Rotate PDF',applicationCategory:'UtilitiesApplication',operatingSystem:'Any',url:'https://deskutil.com/converters/rotate-pdf/',offers:{'@type':'Offer',price:'0',priceCurrency:'USD'},featureList:['Rotate PDF pages 90, 180, or 270 degrees clockwise','All pages or a page range','Adds to existing page rotation','Password-protected PDF error','Download rotated.pdf']},
{'@context':'https://schema.org','@type':'FAQPage',mainEntity:[
{'@type':'Question',name:'How does Rotate PDF turn pages?',acceptedAnswer:{'@type':'Answer',text:'It sets each chosen page rotation with pdf-lib, adding 90, 180, or 270 degrees clockwise to any rotation already on the page. Pages are not redrawn as images.'}},
