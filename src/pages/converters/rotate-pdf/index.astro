---
import BaseLayout from '../../../layouts/BaseLayout.astro';
const description='Rotate a PDF in your browser by 90, 180, or 270 degrees clockwise. Apply to all pages or a page range, then download rotated.pdf. Nothing is uploaded.';
const jsonLd=[
