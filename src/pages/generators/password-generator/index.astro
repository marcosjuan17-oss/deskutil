---
import BaseLayout from '../../../layouts/BaseLayout.astro';
const description='Generate strong random passwords in your browser with crypto.getRandomValues. Set length and options, then copy or download a list. Nothing is uploaded.';
const jsonLd=[
{'@context':'https://schema.org','@type':'BreadcrumbList',itemListElement:[{'@type':'ListItem',position:1,name:'Home',item:'https://deskutil.com/'},{'@type':'ListItem',position:2,name:'Generator Tools',item:'https://deskutil.com/generators/'},{'@type':'ListItem',position:3,name:'Password Generator',item:'https://deskutil.com/generators/password-generator/'}]},
{'@context':'https://schema.org','@type':'SoftwareApplication',name:'Password Generator',applicationCategory:'SecurityApplication',operatingSystem:'Any',url:'https://deskutil.com/generators/password-generator/',offers:{'@type':'Offer',price:'0',priceCurrency:'USD'},featureList:['Cryptographically strong randomness','Length slider','Lowercase uppercase numbers symbols','Exclude similar characters','Copy or download a list','Strength hint']},
{'@context':'https://schema.org','@type':'FAQPage',mainEntity:[
{'@type':'Question',name:'How are passwords generated?',acceptedAnswer:{'@type':'Answer',text:'The generator uses crypto.getRandomValues from the Web Crypto API for cryptographically strong random numbers. It does not use Math.random.'}},
{'@type':'Question',name:'What does exclude similar characters do?',acceptedAnswer:{'@type':'Answer',text:'It removes easily confused characters such as 0, O, 1, and l from the pool so passwords are easier to type without mixing look-alikes.'}},
{'@type':'Question',name:'Are passwords uploaded or stored?',acceptedAnswer:{'@type':'Answer',text:'No. Generation stays in your browser. Deskutil never receives the passwords, and nothing is uploaded.'}},
{'@type':'Question',name:'How is password strength estimated?',acceptedAnswer:{'@type':'Answer',text:'The hint is based on length and the size of the character set (estimated entropy). It is a guide, not a guarantee against every attack.'}},
{'@type':'Question',name:'Can I generate more than one password?',acceptedAnswer:{'@type':'Answer',text:'Yes. Set a count from 1 to 50, generate a list, then copy or download it as a text file.'}}
]}
