---
import BaseLayout from '../../../layouts/BaseLayout.astro';
const description='Free compound interest calculator. Enter principal, rate, tenure, and compounding frequency to see final amount and interest. Work stays in your browser.';
const jsonLd=[
{'@context':'https://schema.org','@type':'BreadcrumbList',itemListElement:[{'@type':'ListItem',position:1,name:'Home',item:'https://deskutil.com/'},{'@type':'ListItem',position:2,name:'Finance',item:'https://deskutil.com/finance/'},{'@type':'ListItem',position:3,name:'Compound Interest Calculator',item:'https://deskutil.com/finance/compound-interest-calculator/'}]},
{'@context':'https://schema.org','@type':'SoftwareApplication',name:'Compound Interest Calculator',applicationCategory:'FinanceApplication',operatingSystem:'Any',url:'https://deskutil.com/finance/compound-interest-calculator/',offers:{'@type':'Offer',price:'0',priceCurrency:'USD'},featureList:['Final amount','Interest earned','Principal amount','Optional monthly contribution','Tenure in years and months','Daily, monthly, quarterly, half-yearly, or yearly compounding','Copy compound interest breakdown']},
