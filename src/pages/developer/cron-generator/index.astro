---
import BaseLayout from '../../../layouts/BaseLayout.astro';
const description='Build a 5-field Unix cron expression in your browser. Use presets, read a plain-English explanation, copy it, and preview the next five local run times.';
const jsonLd=[
{'@context':'https://schema.org','@type':'BreadcrumbList',itemListElement:[{'@type':'ListItem',position:1,name:'Home',item:'https://deskutil.com/'},{'@type':'ListItem',position:2,name:'Developer Tools',item:'https://deskutil.com/developer/'},{'@type':'ListItem',position:3,name:'Cron Generator',item:'https://deskutil.com/developer/cron-generator/'}]},
{'@context':'https://schema.org','@type':'SoftwareApplication',name:'Cron Generator',applicationCategory:'DeveloperApplication',operatingSystem:'Any',url:'https://deskutil.com/developer/cron-generator/',offers:{'@type':'Offer',price:'0',priceCurrency:'USD'},featureList:['Build cron expression','Cron presets','Human explanation','Next run times','Copy expression']},
{'@context':'https://schema.org','@type':'FAQPage',mainEntity:[
{'@type':'Question',name:'What is a Unix cron expression?',acceptedAnswer:{'@type':'Answer',text:'A classic Unix cron expression has five fields: minute, hour, day of month, month, and day of week. Together they describe when a job should run.'}},
{'@type':'Question',name:'How do I read the next run times?',acceptedAnswer:{'@type':'Answer',text:'The tool calculates the next five matching times from now using your five-field expression and lists them in your local timezone.'}},
{'@type':'Question',name:'Which timezone is used?',acceptedAnswer:{'@type':'Answer',text:'Next run times use your browser’s local timezone, not UTC, unless your device is already set to UTC.'}},
{'@type':'Question',name:'Does this tool run my cron jobs?',acceptedAnswer:{'@type':'Answer',text:'No. It only helps you write and understand an expression. It does not schedule or execute commands.'}}
]}
];
---
<BaseLayout title="Cron Expression Generator — Unix 5-Field Schedules" description={description} canonical="https://deskutil.com/developer/cron-generator/" jsonLd={jsonLd}>
<div class="shell breadcrumbs"><nav aria-label="Breadcrumb"><ol><li><a href="/">Home</a></li><li><a href="/developer/">Developer</a></li><li aria-current="page">Cron Generator</li></ol></nav></div>
<section class="shell page-heading tool-wrap"><p class="eyebrow">Developer tool</p><h1>Cron Expression Generator</h1><p>Build a 5-field Unix cron schedule, read it in plain English, and preview the next five run times in your local timezone.</p>
<div class="tool-panel"><div class="tool-topbar" role="toolbar" aria-label="Cron actions"><button class="tool-button primary" id="explain" type="button">Explain</button><button class="tool-button" id="copy" type="button">Copy expression</button><span class="privacy-note">Processed only in your browser</span></div>
<div class="tool-fields"><div class="cron-grid">
<div class="tool-field"><label for="cron-min">Minute</label><input class="field-input mono" id="cron-min" value="*" /></div>
<div class="tool-field"><label for="cron-hour">Hour</label><input class="field-input mono" id="cron-hour" value="*" /></div>
<div class="tool-field"><label for="cron-dom">Day</label><input class="field-input mono" id="cron-dom" value="*" /></div>
<div class="tool-field"><label for="cron-month">Month</label><input class="field-input mono" id="cron-month" value="*" /></div>
<div class="tool-field"><label for="cron-dow">Weekday</label><input class="field-input mono" id="cron-dow" value="*" /></div>
</div>
<div class="tool-field grow"><label for="cron-expr">Expression</label><input class="field-input cron-expr" id="cron-expr" value="* * * * *" spellcheck="false" autocomplete="off" /></div>
<div class="preset-row"><button class="tool-button" type="button" data-cron="* * * * *">Every minute</button><button class="tool-button" type="button" data-cron="0 * * * *">Hourly</button><button class="tool-button" type="button" data-cron="0 0 * * *">Daily midnight</button><button class="tool-button" type="button" data-cron="0 9 * * 1-5">Weekdays 9am</button></div></div>
<div class="tool-output prose-output" id="cron-results"><p><strong>Explanation</strong></p><p>A human-readable schedule will appear here.</p><p><strong>Next 5 run times</strong></p><p>Local times will appear after you explain an expression.</p></div>
<p class="status" id="status" role="status" aria-live="polite">Edit the fields or pick a preset, then choose Explain.</p></div>
<div class="content-grid"><article class="prose"><h2>How to use the cron generator</h2><p>Fill the five Unix fields or type a single expression. Presets cover every minute, hourly, daily midnight, and weekdays at 9am. Choose <strong>Explain</strong> for a plain-English description and the next five local run times, then <strong>Copy expression</strong> to copy the five-field string.</p>
<h2>Frequently asked questions</h2>
<h3>What is a Unix cron expression?</h3><p>Five fields separated by spaces: minute (0–59), hour (0–23), day of month (1–31), month (1–12), and day of week (0–7, where both 0 and 7 are Sunday).</p>
<h3>How do I read the next run times?</h3><p>They are the next five minutes that match the expression, starting after the current minute, shown in your local timezone.</p>
<h3>Which timezone is used?</h3><p>Your browser’s local timezone. The same expression can describe different clock times for people in other zones.</p>
<h3>Does this tool run my cron jobs?</h3><p>No. It only helps you write and understand an expression. Nothing is scheduled on a server.</p></article>
<aside class="aside-card"><h2>Explore Deskutil</h2><ul><li><a href="/developer/">Developer tools</a></li><li><a href="/">All live tools</a></li><li><a href="/privacy/">How privacy works</a></li><li><a href="/developer/json-formatter/">JSON Formatter</a></li><li><a href="/developer/regex-tester/">Regex Tester</a></li><li><a href="/developer/sql-formatter/">SQL Formatter</a></li></ul></aside></div></section>
<script>
const fields={minute:document.querySelector<HTMLInputElement>('#cron-min')!,hour:document.querySelector<HTMLInputElement>('#cron-hour')!,dom:document.querySelector<HTMLInputElement>('#cron-dom')!,month:document.querySelector<HTMLInputElement>('#cron-month')!,dow:document.querySelector<HTMLInputElement>('#cron-dow')!};
const expr=document.querySelector<HTMLInputElement>('#cron-expr')!;
const results=document.querySelector<HTMLDivElement>('#cron-results')!;
const status=document.querySelector<HTMLParagraphElement>('#status')!;
const MONTHS:Record<string,number>={JAN:1,FEB:2,MAR:3,APR:4,MAY:5,JUN:6,JUL:7,AUG:8,SEP:9,OCT:10,NOV:11,DEC:12};
const DOWS:Record<string,number>={SUN:0,MON:1,TUE:2,WED:3,THU:4,FRI:5,SAT:6};
const MONTH_NAMES=['','January','February','March','April','May','June','July','August','September','October','November','December'];
const DOW_NAMES=['Sunday','Monday','Tuesday','Wednesday','Thursday','Friday','Saturday','Sunday'];
const setStatus=(message:string,kind='')=>{status.textContent=message;status.className=`status ${kind}`.trim()};
const escapeHtml=(value:string)=>{const chars:Record<string,string>={'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'};return value.replace(/[&<>"']/g,(ch)=>chars[ch]??ch)};
const readExpr=()=>`${fields.minute.value.trim()} ${fields.hour.value.trim()} ${fields.dom.value.trim()} ${fields.month.value.trim()} ${fields.dow.value.trim()}`;
const applyExpr=(value:string)=>{const parts=value.trim().split(/\s+/);if(parts.length!==5)throw new Error('A Unix cron expression needs exactly 5 fields: minute hour day month weekday.');fields.minute.value=parts[0]??'';fields.hour.value=parts[1]??'';fields.dom.value=parts[2]??'';fields.month.value=parts[3]??'';fields.dow.value=parts[4]??'';expr.value=parts.join(' ')};
const parseToken=(token:string,names?:Record<string,number>)=>{if(names&&/^[A-Za-z]+$/.test(token)){const value=names[token.toUpperCase()];if(value===undefined)throw new Error(`Unknown name "${token}".`);return value}if(!/^\d+$/.test(token))throw new Error(`"${token}" is not a valid cron value.`);return Number(token)};
const expand=(field:string,min:number,max:number,names?:Record<string,number>)=>{
  const values=new Set<number>();
  if(!field)throw new Error('A cron field is empty.');
  for(const part of field.split(',')){
    const [range,stepRaw]=part.split('/');
    const step=stepRaw===undefined?1:Number(stepRaw);
    if(!Number.isInteger(step)||step<1)throw new Error(`Invalid step in "${field}".`);
    let start=min,end=max;
    if(range&&range!=='*'){
      if(range.includes('-')){const bits=range.split('-');start=parseToken(bits[0]??'',names);end=parseToken(bits[1]??'',names)}
      else start=end=parseToken(range,names);
    }
    if(start>end||start<min||end>max)throw new Error(`Value out of range in "${field}".`);
    for(let n=start;n<=end;n+=step)values.add(n);
  }
  if(max===7&&values.has(7))values.add(0);
  return values;
};
const describeField=(field:string,every:string,names?:string[],alias?:Record<string,number>)=>{
  if(field==='*')return every;
  if(/^\*\/\d+$/.test(field))return `every ${field.slice(2)} ${every.replace(/^every /,'')}`;
  const bits=field.split(',').map((bit)=>{
    const [range,step]=bit.split('/');
    const suffix=step?` (every ${step})`:'';
    if(range==='*')return `every ${step} ${every.replace(/^every /,'')}`;
    if(range?.includes('-')){
      const ends=range.split('-');
      const a=ends[0]??'';const b=ends[1]??'';
      const start=parseToken(a,alias);const end=parseToken(b,alias);
      const left=names?names[start]??a:a;const right=names?names[end]??b:b;
      return `${left} through ${right}${suffix}`;
    }
    const n=parseToken(range??'',alias);
    return `${names?names[n]??range:range}${suffix}`;
  });
  return bits.join(' and ');
};
const describe=(parts:string[])=>{
  const minute=parts[0]??'';const hour=parts[1]??'';const dom=parts[2]??'';const month=parts[3]??'';const dow=parts[4]??'';
  if(parts.join(' ')==='* * * * *')return 'Every minute.';
  if(minute==='0'&&hour==='*'&&dom==='*'&&month==='*'&&dow==='*')return 'At the start of every hour.';
  if(/^\d+$/.test(minute)&&/^\d+$/.test(hour)&&dom==='*'&&month==='*'&&dow==='*')return `At ${hour.padStart(2,'0')}:${minute.padStart(2,'0')} every day.`;
  if(/^\d+$/.test(minute)&&/^\d+$/.test(hour)&&dom==='*'&&month==='*'&&dow==='1-5')return `At ${hour.padStart(2,'0')}:${minute.padStart(2,'0')} Monday through Friday.`;
  const minText=describeField(minute,'every minute');
  const hourText=describeField(hour,'every hour');
  const monthText=describeField(month,'every month',MONTH_NAMES,MONTHS);
  const domText=describeField(dom,'every day of the month');
  const dowText=describeField(dow,'every day of the week',DOW_NAMES,DOWS);
  const time=minute==='*'&&hour==='*'?'Every minute':`At minute ${minText} of ${hourText}`;
  return `${time}, on ${domText}, in ${monthText}, on ${dowText}.`;
};
const matches=(date:Date,mins:Set<number>,hours:Set<number>,doms:Set<number>,months:Set<number>,dows:Set<number>,domAll:boolean,dowAll:boolean)=>{
  if(!mins.has(date.getMinutes())||!hours.has(date.getHours())||!months.has(date.getMonth()+1))return false;
  const domOk=doms.has(date.getDate());
  const dowOk=dows.has(date.getDay());
  if(domAll&&dowAll)return true;
  if(!domAll&&dowAll)return domOk;
  if(domAll&&!dowAll)return dowOk;
  return domOk||dowOk;
};
const nextRuns=(parts:string[])=>{
  const minute=parts[0]??'';const hour=parts[1]??'';const dom=parts[2]??'';const month=parts[3]??'';const dow=parts[4]??'';
  const mins=expand(minute,0,59);
  const hours=expand(hour,0,23);
  const doms=expand(dom,1,31);
  const months=expand(month,1,12,MONTHS);
  const dows=expand(dow,0,7,DOWS);
  const cursor=new Date();
  cursor.setSeconds(0,0);
  cursor.setMinutes(cursor.getMinutes()+1);
  const found:Date[]=[];
  for(let i=0;i<366*24*60&&found.length<5;i++){
    if(matches(cursor,mins,hours,doms,months,dows,dom==='*',dow==='*'))found.push(new Date(cursor));
    cursor.setMinutes(cursor.getMinutes()+1);
  }
  if(!found.length)throw new Error('No matching times in the next year. Check the fields.');
  return found;
};
const explain=()=>{
  applyExpr(expr.value.trim()||readExpr());
  const parts=expr.value.trim().split(/\s+/);
  expand(parts[0]??'',0,59);expand(parts[1]??'',0,23);expand(parts[2]??'',1,31);expand(parts[3]??'',1,12,MONTHS);expand(parts[4]??'',0,7,DOWS);
  const runs=nextRuns(parts);
  const explanation=describe(parts);
  results.innerHTML=`<p><strong>Explanation</strong></p><p>${escapeHtml(explanation)}</p><p><strong>Next 5 run times</strong></p><p>Shown in your local timezone.</p><ol>${runs.map((d)=>`<li>${escapeHtml(d.toLocaleString(undefined,{weekday:'short',year:'numeric',month:'short',day:'numeric',hour:'2-digit',minute:'2-digit',timeZoneName:'short'}))}</li>`).join('')}</ol>`;
  return 'Expression explained.';
};
document.querySelector('#explain')?.addEventListener('click',()=>{try{setStatus(explain(),'success')}catch(error){setStatus(error instanceof Error?error.message:'Could not explain this expression.','error')}});
document.querySelector('#copy')?.addEventListener('click',async()=>{try{applyExpr(expr.value.trim()||readExpr());await navigator.clipboard.writeText(expr.value);setStatus('Copied cron expression.','success')}catch(error){setStatus(error instanceof Error?error.message:'Could not copy.','error')}});
for(const input of Object.values(fields))input.addEventListener('input',()=>{expr.value=readExpr()});
expr.addEventListener('change',()=>{try{applyExpr(expr.value);setStatus('Expression fields updated.')}catch(error){setStatus(error instanceof Error?error.message:'Could not parse this expression.','error')}});
document.querySelectorAll<HTMLButtonElement>('[data-cron]').forEach((button)=>button.addEventListener('click',()=>{try{applyExpr(button.dataset.cron||'');setStatus(explain(),'success')}catch(error){setStatus(error instanceof Error?error.message:'Could not apply this preset.','error')}}));
</script></BaseLayout>
