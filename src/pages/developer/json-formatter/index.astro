---
import BaseLayout from '../../../layouts/BaseLayout.astro';
const description='Free JSON formatter to format, minify, and validate JSON online. Copy or download clean results while your data stays private in your browser.';
const jsonLd=[
{'@context':'https://schema.org','@type':'BreadcrumbList',itemListElement:[{'@type':'ListItem',position:1,name:'Home',item:'https://deskutil.com/'},{'@type':'ListItem',position:2,name:'Developer Tools',item:'https://deskutil.com/developer/'},{'@type':'ListItem',position:3,name:'JSON Formatter',item:'https://deskutil.com/developer/json-formatter/'}]},
{'@context':'https://schema.org','@type':'SoftwareApplication',name:'JSON Formatter',applicationCategory:'DeveloperApplication',operatingSystem:'Any',url:'https://deskutil.com/developer/json-formatter/',offers:{'@type':'Offer',price:'0',priceCurrency:'USD'},featureList:['Format JSON','Minify JSON','Validate JSON','Copy JSON','Download JSON']},
{'@context':'https://schema.org','@type':'FAQPage',mainEntity:[
{'@type':'Question',name:'What does a JSON formatter do?',acceptedAnswer:{'@type':'Answer',text:'A JSON formatter adds consistent indentation and line breaks so JSON data is easier to read and inspect.'}},
{'@type':'Question',name:'Is my JSON uploaded or stored?',acceptedAnswer:{'@type':'Answer',text:'No. The formatter processes your input entirely in your browser and does not send pasted content to a server.'}},
{'@type':'Question',name:'How do I fix invalid JSON?',acceptedAnswer:{'@type':'Answer',text:'Use Validate to see a clear parsing error. Common problems include missing quotes, trailing commas, and unmatched brackets.'}},
{'@type':'Question',name:'What is minified JSON?',acceptedAnswer:{'@type':'Answer',text:'Minified JSON removes unnecessary spaces and line breaks while preserving the same data.'}}
]}
];
---
<BaseLayout title="JSON Formatter Online — Format & Validate JSON" description={description} canonical="https://deskutil.com/developer/json-formatter/" jsonLd={jsonLd}>
<div class="shell breadcrumbs"><nav aria-label="Breadcrumb"><ol><li><a href="/">Home</a></li><li><a href="/developer/">Developer</a></li><li aria-current="page">JSON Formatter</li></ol></nav></div>
<section class="shell page-heading tool-wrap"><p class="eyebrow">Developer tool</p><h1>JSON Formatter</h1><p>Format, minify, and validate JSON instantly. Everything runs locally in your browser, so your data never leaves your device.</p>
<div class="tool-panel"><div class="tool-topbar" role="toolbar" aria-label="JSON actions"><button class="tool-button primary" id="format" type="button">Format</button><button class="tool-button" id="minify" type="button">Minify</button><button class="tool-button" id="validate" type="button">Validate</button><button class="tool-button" id="copy" type="button">Copy</button><button class="tool-button" id="download" type="button">Download</button><span class="privacy-note">Processed only in your browser</span></div><label class="editor-label" for="json-input">JSON input</label><textarea id="json-input" spellcheck="false" autocomplete="off" placeholder={'Paste JSON here, for example:\n{\n  "name": "Deskutil"\n}'}></textarea><p class="status" id="status" role="status" aria-live="polite">Paste JSON, then choose an action.</p></div>
<div class="content-grid"><article class="prose"><h2>How to use the JSON formatter</h2><p>Paste or type JSON in the editor above. Choose <strong>Format</strong> for readable indentation, <strong>Minify</strong> for compact output, or <strong>Validate</strong> to check the syntax without changing it. Use Copy or Download when you are done.</p><h2>Frequently asked questions</h2><h3>What does a JSON formatter do?</h3><p>It adds consistent indentation and line breaks so nested objects and arrays are easier to read.</p><h3>Is my JSON uploaded or stored?</h3><p>No. All parsing and formatting happens in your browser. Deskutil never receives the content.</p><h3>How do I fix invalid JSON?</h3><p>Choose Validate to see the browser’s parsing error. Check for missing double quotes, trailing commas, or unmatched braces and brackets.</p><h3>What is minified JSON?</h3><p>Minified JSON removes unnecessary whitespace while keeping the exact same data structure.</p></article><aside class="aside-card"><h2>Explore Deskutil</h2><ul><li><a href="/developer/">Developer tools</a></li><li><a href="/">All live tools</a></li><li><a href="/privacy/">How privacy works</a></li></ul></aside></div></section>
<script>
const input=document.querySelector<HTMLTextAreaElement>('#json-input')!;const status=document.querySelector<HTMLParagraphElement>('#status')!;
const setStatus=(message:string,kind='')=>{status.textContent=message;status.className=`status ${kind}`.trim()};
const parse=()=>{if(!input.value.trim())throw new Error('Enter some JSON first.');return JSON.parse(input.value)};
const act=(transform?: (value:unknown)=>string,success='Valid JSON.')=>{try{const value=parse();if(transform)input.value=transform(value);setStatus(success,'success')}catch(error){const message=error instanceof Error?error.message:'Invalid JSON.';setStatus(`Invalid JSON: ${message.replace(/^JSON\.parse:\s*/i,'')}`,'error');input.focus()}};
document.querySelector('#format')?.addEventListener('click',()=>act((value)=>JSON.stringify(value,null,2),'JSON formatted successfully.'));
document.querySelector('#minify')?.addEventListener('click',()=>act((value)=>JSON.stringify(value),'JSON minified successfully.'));
document.querySelector('#validate')?.addEventListener('click',()=>act(undefined,'Valid JSON.'));
document.querySelector('#copy')?.addEventListener('click',async()=>{try{parse();await navigator.clipboard.writeText(input.value);setStatus('Copied to clipboard.','success')}catch(error){setStatus(error instanceof SyntaxError?`Invalid JSON: ${error.message}`:'Could not copy. Select the text and copy it manually.','error')}});
document.querySelector('#download')?.addEventListener('click',()=>{try{parse();const url=URL.createObjectURL(new Blob([input.value],{type:'application/json'}));const link=document.createElement('a');link.href=url;link.download='formatted.json';link.click();URL.revokeObjectURL(url);setStatus('JSON downloaded.','success')}catch(error){setStatus(`Invalid JSON: ${error instanceof Error?error.message:'Check the input.'}`,'error')}});
input.addEventListener('keydown',(event)=>{if(event.key==='Tab'){event.preventDefault();const start=input.selectionStart,end=input.selectionEnd;input.setRangeText('  ',start,end,'end')}});
</script></BaseLayout>
