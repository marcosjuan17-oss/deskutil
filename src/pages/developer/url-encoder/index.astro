---
import BaseLayout from '../../../layouts/BaseLayout.astro';
const description='Encode or decode URLs in your browser with encodeURIComponent, encodeURI, or plus-as-space form encoding. Copy or download the result. Nothing is uploaded.';
const jsonLd=[
{'@context':'https://schema.org','@type':'BreadcrumbList',itemListElement:[{'@type':'ListItem',position:1,name:'Home',item:'https://deskutil.com/'},{'@type':'ListItem',position:2,name:'Developer Tools',item:'https://deskutil.com/developer/'},{'@type':'ListItem',position:3,name:'URL Encoder',item:'https://deskutil.com/developer/url-encoder/'}]},
{'@context':'https://schema.org','@type':'SoftwareApplication',name:'URL Encoder',applicationCategory:'DeveloperApplication',operatingSystem:'Any',url:'https://deskutil.com/developer/url-encoder/',offers:{'@type':'Offer',price:'0',priceCurrency:'USD'},featureList:['Encode URL','Decode URL','encodeURIComponent','encodeURI','Plus-as-space form encoding','Copy result','Download result']},
{'@context':'https://schema.org','@type':'FAQPage',mainEntity:[
{'@type':'Question',name:'What is the difference between encodeURIComponent and encodeURI?',acceptedAnswer:{'@type':'Answer',text:'encodeURIComponent encodes a single value, including reserved characters such as slash, question mark, hash, ampersand, and equals. encodeURI encodes a full URL and leaves those structural characters intact so the address still parses as a URL.'}},
{'@type':'Question',name:'When should I use plus-as-space encoding?',acceptedAnswer:{'@type':'Answer',text:'application/x-www-form-urlencoded query strings often use a plus sign for spaces instead of %20. Choose that mode when you are encoding or decoding form-style query values, not a full URL path.'}},
{'@type':'Question',name:'Is my text uploaded or stored?',acceptedAnswer:{'@type':'Answer',text:'No. Encoding and decoding run entirely in your browser with the built-in encodeURIComponent, decodeURIComponent, encodeURI, and decodeURI functions. Nothing you paste is sent to a server.'}},
{'@type':'Question',name:'Why did decoding fail?',acceptedAnswer:{'@type':'Answer',text:'decodeURIComponent and decodeURI throw when a percent sequence is malformed, such as a lone percent sign or incomplete hex digits. Fix the percent-encoding and try again.'}},
{'@type':'Question',name:'Can I encode Unicode and emoji?',acceptedAnswer:{'@type':'Answer',text:'Yes. The browser functions UTF-8 percent-encode non-ASCII characters, so international text and emoji become valid percent sequences in the output.'}}
]}
