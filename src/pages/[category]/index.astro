---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getLiveCategories, getToolsForCategory } from '../../data/tools';
export function getStaticPaths(){return getLiveCategories().map((category)=>({params:{category:category.slug},props:{category}}))}
const { category }=Astro.props; const categoryTools=getToolsForCategory(category.slug);
---
<BaseLayout title={`${category.name} Tools — Deskutil`} description={`${category.description} Free, focused utilities that run in your browser.`}><div class="shell page-heading"><p class="eyebrow">Tools by category</p><h1>{category.name} tools</h1><p>{category.description}</p></div><section class="section shell">{categoryTools.length?<div class="card-grid">{categoryTools.map((tool)=><a class="card" href={tool.path}><h2>{tool.name}</h2><p>{tool.description}</p></a>)}</div>:<div class="empty-state"><strong>No tools here yet.</strong><br/>We add focused utilities one at a time. Try the <a href="/developer/json-formatter/">JSON Formatter</a> today.</div>}</section></BaseLayout>
